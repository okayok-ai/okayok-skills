# Okayok standard: normalize text to LF in the repo and working tree.
* text=auto eol=lf

# Explicit text types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.env text eol=lf
*.example text eol=lf
*.gitignore text eol=lf
*.dockerignore text eol=lf
*.prettierrc text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Leave binaries alone
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.wasm binary
*.mp4 binary
*.mp3 binary
*.lockb binary
